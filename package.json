{
  "name": "tinywebgpu",
  "version": "0.4.0",
  "type": "module",
  "description": "One file, no dependencies, no build step. A WebGPU micro-framework for shader-first work: dual-schema pipelines, fullscreen shaders and compute.",
  "main": "./tinywebgpu.js",
  "exports": "./tinywebgpu.js",
  "files": [
    "tinywebgpu.js",
    "tinywebgpu.min.js",
    "wgsl_shorthand.js",
    "README.md",
    "API.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node test/layout.test.mjs",
    "test:min": "TWG_ENTRY=../tinywebgpu.min.js node test/layout.test.mjs",
    "build:min": "node build-min.mjs"
  },
  "license": "MIT",
  "author": "Matthijs Keuper",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lampmaker/tinywebgpu.git"
  },
  "homepage": "https://lampmaker.github.io/tinywebgpu/",
  "keywords": [
    "webgpu",
    "wgsl",
    "shader",
    "compute",
    "gpgpu",
    "graphics"
  ],
  "devDependencies": {
    "esbuild": "^0.25.0"
  }
}
